# Copy to .env and adjust. Never commit .env.

# local = DuckDB file at DUCKDB_PATH; motherduck = hosted DuckDB (needs a token)
DB_TARGET=local
DUCKDB_PATH=data/gridcarbon.duckdb

# MotherDuck (Phase 4): https://app.motherduck.com -> Settings -> Access tokens
MOTHERDUCK_TOKEN=
MOTHERDUCK_DATABASE=gridcarbon

LOG_LEVEL=INFO
# Days re-fetched on every incremental run (late-arriving `actual` intensity)
LOOKBACK_DAYS=3
